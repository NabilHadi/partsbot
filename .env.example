# Copy to .env and edit. Never commit .env.
PORT=3000
DATABASE_URL=postgres://partsbot:partsbot@localhost:5432/partsbot

# Local dev points at the mock (`npm run mock`). In production use the real
# OneEPC Bot API base URL and a per-environment, read-only API key.
ONEEPC_BASE_URL=http://localhost:4010/api/bot/v1
ONEEPC_API_KEY=mock-dev-key

# Mock server only (npm run mock)
MOCK_PORT=4010
MOCK_API_KEY=mock-dev-key

# Zernio WhatsApp (docs/zernio-notes.md). Leave ZERNIO_WEBHOOK_SECRET empty and the
# webhook route is not mounted. Never commit real values.
# You choose the webhook secret yourself (Zernio does not generate one); send the same
# value in POST /v1/webhooks/settings. Generate: openssl rand -hex 32
ZERNIO_WEBHOOK_SECRET=
ZERNIO_API_KEY=
# accountId of the connected WhatsApp number (GET /v1/accounts). Events for other accounts are ignored.
ZERNIO_ACCOUNT_ID=
