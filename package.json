{
  "name": "partsbot",
  "version": "0.1.0",
  "private": true,
  "description": "PartsBot: WhatsApp parts-lookup assistant for auto-parts shops (OneEPC-backed)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "mock": "tsx src/mock/oneepc-mock.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "chat": "tsx src/scripts/chat.ts",
    "templates": "tsx src/scripts/print-templates.ts > docs/bot-templates.md",
    "import-stock": "tsx src/scripts/import-stock.ts",
    "shop": "tsx src/scripts/shop.ts"
  },
  "dependencies": {
    "@zernio/node": "0.2.1325",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
